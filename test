<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Le Trésor Public - Accueil</title>
    
    <script type="text/javascript">
        function googleTranslateElementInit() {
            new google.translate.TranslateElement({pageLanguage: 'fr'}, 'google_translate_element');
        }
    </script>
    <script type="text/javascript" src="//translate.google.com/translate_a/element.js?cb=googleTranslateElementInit"></script>

    <style>
        body { 
            font-family: 'Comic Sans MS', cursive; text-align: center; margin: 0; padding: 0; 
            background: radial-gradient(circle at center, #1b2735 0%, #090a0f 100%);
            color: #ffffff; overflow-x: hidden; min-height: 100vh; position: relative;
        }

        /* STYLE TRADUCTEUR */
        #google_translate_element { 
            position: absolute; top: 10px; left: 10px; z-index: 3000; 
            opacity: 0.6; transform: scale(0.85); transition: 0.3s;
        }
        #google_translate_element:hover { opacity: 1; }

        .header-container { position: relative; padding-top: 20px; z-index: 100; }
        .titre-fraternite { display: block; font-size: 2em; letter-spacing: 3px; color: #f0e68c; text-shadow: 0 0 15px rgba(255,230,140,0.5); font-weight: bold; margin-bottom: 10px; }
        
        .menu-table { margin: 10px auto; border-radius: 10px; background-color: #008080; border-collapse: collapse; position: relative; z-index: 10; }
        .menu-table td { border: 1px solid #FFFFFF; transition: 0.3s; }
        .menu-table td:hover { background-color: #00b3b3; }
        .menu-table a { display: block; padding: 12px 20px; text-decoration: none; color: #FFFFFF; font-weight: bold; }

        .soleil-cadre { width: 140px; height: 140px; background: #FFD700; border-radius: 50%; display: flex; align-items: center; justify-content: center; box-shadow: 0 0 25px #FFA500; margin: 20px auto; position: relative; z-index: 20; transition: 0.8s; text-decoration: none; }
        .soleil-cadre h1 { font-size: 0.9em; color: #333; line-height: 1.1; margin: 0; padding: 10px; }
        .soleil-cadre:hover { background: linear-gradient(45deg, #ff0000, #ff7f00, #ffff00, #00ff00, #0000ff); box-shadow: 0 0 50px white; transform: scale(1.1) rotate(360deg); }

        /* LA TERRE QUI TOURNE */
        .terre-don { 
            width: 350px; height: 350px; margin: 40px auto; border-radius: 50%; 
            background-image: url('https://upload.wikimedia.org/wikipedia/commons/thumb/c/c3/Solarsystemscope_texture_2k_earth_daymap.jpg/1200px-Solarsystemscope_texture_2k_earth_daymap.jpg'); 
            background-size: cover; display: flex; flex-direction: column; align-items: center; justify-content: center; 
            text-decoration: none; color: white; box-shadow: inset -30px -30px 60px rgba(0,0,0,0.9); 
            animation: rotationTerre 40s linear infinite; position: relative; z-index: 5; transition: transform 1.5s;
        }
        .terre-don:hover { transform: scale(1.05); }
        .texte-semis { font-family: 'Georgia', serif; font-style: italic; font-weight: bold; letter-spacing: 2px; text-shadow: 2px 2px 10px black; font-size: 1.4em; padding: 10px; }
        .soustitre-soleil { font-size: 0.7em; text-shadow: 1px 1px 5px black; color: #FFD700; padding: 0 20px; }
        @keyframes rotationTerre { from { background-position: 0 0; } to { background-position: 1000px 0; } }

        /* Rubriques */
        .bulles-grid { display: flex; justify-content: center; gap: 20px; flex-wrap: wrap; padding: 20px; position: relative; z-index: 5; }
        .nuage, .cadre-aide { background: #e0f7fa; border: 3px solid #008080; border-radius: 50px; padding: 20px; width: 320px; color: #000080; transition: 0.4s; text-decoration: none; display: block; }
        .nuage:hover, .cadre-aide:hover { transform: translateY(-10px); background: #ffffff; }

        .phrases-impots { font-size: 0.8em; color: #d32f2f; font-weight: bold; margin: 8px 0; }
        .liste-exemples-discrets { font-size: 0.65em; text-align: left; color: rgba(0, 102, 102, 0.8); font-style: italic; list-style: none; padding-left: 15px; margin-top: 10px; border-top: 1px dashed #008080; padding-top: 5px; }

        .etoile-justice { background: #E6E6FA; border: 3px solid #9370DB; width: 300px; min-height: 250px; clip-path: polygon(50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%); display: flex; flex-direction: column; align-items: center; justify-content: center; text-decoration: none; color: #333; transition: 0.8s; padding: 20px; }
        .etoile-justice:hover { clip-path: circle(50% at 50% 50%); transform: scale(1.1); background: #d1c4e9; }

        /* MOTEUR DE RECHERCHE */
        .moteur-fraternel { 
            background: rgba(255, 255, 255, 0.1); border: 2px solid #f0e68c; padding: 25px; 
            border-radius: 20px; max-width: 600px; margin: 40px auto; position: relative; z-index: 10;
        }
        .moteur-fraternel input { padding: 8px; border-radius: 10px; border: none; margin: 5px; width: 80%; }
        .btn-rayonner { background: #008080; color: white; border: none; padding: 10px 20px; border-radius: 20px; font-weight: bold; cursor: pointer; margin-top: 15px; }
        .btn-rayonner:hover { background: #00b3b3; transform: scale(1.1); }

        /* BOUSSOLE */
        .boussole { font-style: italic; color: #f0e68c; font-size: 0.9em; margin: 20px; padding: 15px; border-top: 1px solid rgba(240,230,140,0.3); }

        .lien-rose { color: #ff1493 !important; font-weight: bold; text-decoration: none; }
        
        /* Étoiles */
        .star { position: fixed; color: white; z-index: -1; text-shadow: 0 0 8px white; animation: twinkle var(--duration) infinite ease-in-out, moveStar var(--move-duration) linear infinite; user-select: none; }
        @keyframes twinkle { 0%, 100% { opacity: 0.2; transform: scale(0.7); } 50% { opacity: 1; transform: scale(1.2); } }
        @keyframes moveStar { from { transform: translateX(-10vw); } to { transform: translateX(110vw); } }

        #btn-son { position: fixed; top: 20px; right: 20px; z-index: 1000; background: none; border: none; color: white; cursor: pointer; font-size: 40px; filter: drop-shadow(0 0 5px white); }
        #coffre-magique { position: fixed; font-size: 55px; z-index: 8; filter: drop-shadow(0 0 15px gold); cursor: pointer; }
        .particule { position: fixed; pointer-events: none; z-index: 1000; font-size: 24px; }
        .oiseau-volant { position: fixed; font-size: 40px; z-index: 7; transition: transform 6s linear; pointer-events: none; }
        .message-volant { position: fixed; background: rgba(255,255,255,0.9); color: #2E7D32; padding: 5px 12px; border-radius: 20px; font-weight: bold; border: 1px solid #4CAF50; z-index: 9; transition: all 1.8s ease-in; white-space: nowrap; }
        .lien-copyright { display: inline-block; color: rgba(255,255,255,0.6); text-decoration: none; font-weight: bold; transition: 0.4s; padding: 15px; position: relative; z-index: 200; }
        .lien-copyright:hover { color: #fffce0; text-shadow: 0 0 15px #fff, 0 0 25px #f0e68c; transform: scale(1.1); }
    </style>
</head>
<body>

    <div id="google_translate_element"></div>

    <div class="header-container">
        <div class="titre-fraternite">La fraternité du palais nature</div>
        <table class="menu-table">
            <tr>
                <td><a href="index.html">Accueil</a></td>
                <td><a href="formulaire.html">Semer</a></td>
                <td><a href="jardin.html">Le Jardin</a></td>
                <td><a href="impot.html">Impôts Publics</a></td>
                <td><a href="regulation.html">Régulation</a></td>
                <td><a href="urgence.html">Aide</a></td>
            </tr>
        </table>
    </div>

    <button id="btn-son" onclick="toggleSon()">🕊️</button>

    <a href="jardin.html" class="soleil-cadre"><h1>Le Trésor Public du jardin collectif</h1></a>

    <a href="jardin.html" class="terre-don">
        <div class="texte-semis"><b>LES DONS ENTIERS</b></div>
        <div class="soustitre-soleil">Talents, créations, savoirs, offrandes... Une pure joie altruiste.</div>
    </a>

    <div class="bulles-grid">
        <a href="impot.html" class="nuage">
            <h3 style="margin:0;">📜 L'Espace Temps Public</h3>
            <p style="font-size: 0.8em; font-weight: bold;">Le partage pour l'Œuvre Commune.</p>
            <div class="phrases-impots">Don volontaire : Je suis fier de servir ma cité.</div>
            <ul class="liste-exemples-discrets">
                <li>Nettoyage rivière/bois, réfection route/chemin, aide logistique...</li>
            </ul>
        </a>

        <a href="regulation.html" class="etoile-justice">
            <h3 style="margin:0;">⚖️ Cocon d'Écoute</h3>
            <p style="font-size:0.8em;">Médiation et harmonie citoyenne.</p>
            <p style="font-size:0.6em; color:#555;">Expose ton conflit, reçois le pardon.</p>
        </a>

        <div class="cadre-aide">
            <h3 style="margin:0;">❤️ L'Étoile de la Main Tendue</h3>
            <p style="font-size:0.8em;">Urgence & Détresse : Le cœur et le corps.</p>
            <ul class="liste-exemples-discrets">
                <li>Santé, charpente, farine pour le pain, câlin de l'âme...</li>
            </ul>
            <div style="margin-top:10px;">
                <a href="urgence.html" class="lien-rose">Urgences</a> | <a href="ecoute.html" class="lien-rose">Écoute</a>
            </div>
        </div>
    </div>

    <div class="moteur-fraternel">
        <h3>🔍 Recherche de Fraternité</h3>
        <p>Tu rayonnes dans quel secteur ?</p>
        <input type="text" placeholder="Pays / Ville">
        <p>Distance max de ta dévotion ?</p>
        <input type="range" min="1" max="500" style="width:60%"> <span id="valDist">250</span> km
        <p>Quoi ? Pourquoi ? Pour nous quoi !</p>
        <input type="text" placeholder="Mots-clés (farine, écoute, charpente...)">
        <br>
        <button class="btn-rayonner">Lancer le rayonnement</button>
    </div>

    <div class="boussole">
        🧩 <b>Boussole des complémentaires :</b> Tu prépares le pain que tu vas m'offrir et je prépare la chanson qui va te célébrer.
    </div>

    <div id="coffre-magique" onclick="exploserCadeau()">🎁</div>

    <footer>
        <a href="transition-externe.html" class="lien-copyright">© 2000 le petit prince des jardiniers</a>
    </footer>

    <script>
        // Mise à jour affichage distance
        const range = document.querySelector('input[type="range"]');
        if(range) {
            range.oninput = function() { document.getElementById('valDist').innerHTML = this.value; }
        }

        // ÉTOILES DÉRIVANTES
        function createStar() {
            let s = document.createElement('div'); s.className = 'star';
            s.innerHTML = ['✦','★','✶','✧'][Math.floor(Math.random()*4)];
            s.style.left = Math.random()*100 + 'vw'; s.style.top = Math.random()*100 + 'vh';
            s.style.setProperty('--duration', (Math.random()*3+2)+'s');
            s.style.setProperty('--move-duration', (Math.random()*60+40)+'s');
            document.body.appendChild(s);
        }
        for(let i=0; i<80; i++) createStar();

        // SON
        let audio = new Audio('oiseaux.mp3'); audio.loop = true; let enLecture = false;
        function toggleSon() {
            const btn = document.getElementById('btn-son');
            if (!enLecture) { audio.play().catch(e=>{}); btn.classList.add('actif'); enLecture = true; } 
            else { audio.pause(); btn.classList.remove('actif'); enLecture = false; }
        }

        // CADEAU MOBILE
        const coffre = document.getElementById('coffre-magique');
        let cX = 100, cY = 100;
        function move() {
            cX = Math.random()*(window.innerWidth-100); cY = Math.random()*(window.innerHeight-100);
            coffre.style.left = cX+'px'; coffre.style.top = cY+'px';
            coffre.style.transition = "all 4s ease-in-out";
        }
        setInterval(move, 4000); move();

        // EXPLOSION
        function exploserCadeau() {
            const els = ['🌸', '✨', '🌻', '🍀', '🌟', '❤️'];
            for(let i=0; i<30; i++) {
                const p = document.createElement('div'); p.className = 'particule';
                p.innerHTML = els[Math.floor(Math.random()*els.length)];
                p.style.left = cX+'px'; p.style.top = cY+'px';
                document.body.appendChild(p);
                const a = Math.random()*Math.PI*2, d = Math.random()*200+50;
                p.animate([{transform:'scale(1)', opacity:1}, {transform:`translate(${Math.cos(a)*d}px, ${Math.sin(a)*d}px) scale(0)`, opacity:0}], {duration:1500});
                setTimeout(() => p.remove(), 1500);
            }
        }

        // MESSAGERS
        function creerMessager() {
            const a = document.createElement('div'); a.className = 'oiseau-volant'; 
            a.innerHTML = ['🕊️', '🦋', '🐝'][Math.floor(Math.random()*3)];
            const fromLeft = Math.random() > 0.5;
            a.style.top = Math.random()*window.innerHeight+'px';
            a.style.left = fromLeft ? '-60px' : '100vw';
            a.style.transform = fromLeft ? 'scaleX(1)' : 'scaleX(-1)';
            document.body.appendChild(a);
            setTimeout(() => a.style.transform += fromLeft ? ' translateX(120vw)' : ' translateX(-120vw)', 100);
            setTimeout(() => {
                const m = document.createElement('div'); m.className = 'message-volant'; 
                m.innerHTML = ["PAIX 🕊️", "AMOUR ❤️", "JOIE 🌟"][Math.floor(Math.random()*3)];
                const r = a.getBoundingClientRect();
                m.style.left = r.left+'px'; m.style.top = r.top+'px';
                document.body.appendChild(m);
                setTimeout(() => { m.style.left = cX+'px'; m.style.top = cY+'px'; m.style.opacity = '0'; }, 100);
                setTimeout(() => { exploserCadeau(); m.remove(); }, 1800);
            }, 2500);
            setTimeout(() => a.remove(), 7000);
        }
        setInterval(creerMessager, 6000);
    </script>
</body>
</html>
