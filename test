<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Le Jardin de la Fraternité - Registre</title>
    <style>
        /* --- STYLE DE BASE (CONSERVÉ) --- */
        body { font-family: 'Comic Sans MS', cursive; text-align: center; margin: 0; padding: 0; background-color: #FFFF00; color: #000080; overflow-x: hidden; min-height: 100vh; padding-bottom: 80px; }

        .top-bar { position: relative; width: 100%; min-height: 40px; background: rgba(255,255,255,0.3); padding: 5px 0; }
        #google_translate_element { position: absolute; left: 10px; top: 10px; transform: scale(0.8); transform-origin: top left; }
        
        .menu-table { margin: 5px auto; border-radius: 10px; background-color: #008080; border-collapse: collapse; }
        .menu-table td { padding: 8px 15px; border: 1px solid #FFFFFF; }
        .menu-table a { text-decoration: none; color: #FFFFFF; font-weight: bold; font-size: 0.85em; }
        .menu-table td:hover { background-color: #006666; }

        .phrase-rose { color: #ff1493; font-weight: bold; font-size: 1.1em; text-shadow: 1px 1px 2px #ff69b4; animation: eclat 1.5s infinite alternate; margin-top: 5px; }
        @keyframes eclat { from { opacity: 0.7; } to { opacity: 1; } }
        .phrase-sous { color: #000080; font-weight: bold; margin: 1px 0; font-size: 0.9em; }

        /* ZONE DÉCO HAUTE */
        #jardin-sacre { position: relative; height: 100px; width: 100%; overflow: hidden; background: rgba(255,255,255,0.1); margin-top: 5px; }
        .fleur-clonée { position: absolute; font-size: 25px; animation: apparitionFleur 1s ease-out forwards; }
        @keyframes apparitionFleur { 0% { transform: scale(0) rotate(-50deg); opacity: 0; } 100% { transform: scale(1) rotate(0deg); opacity: 1; } }

        /* FLEURS ÉTOILES VOLANTES */
        .fleur-etoile { position: fixed; pointer-events: none; z-index: 1; font-size: 15px; animation: volEtoile linear infinite; opacity: 0.6; }
        @keyframes volEtoile {
            0% { transform: translate(0, 0) rotate(0deg); }
            25% { transform: translate(100px, 100px) rotate(90deg); }
            50% { transform: translate(0, 200px) rotate(180deg); }
            75% { transform: translate(-100px, 100px) rotate(270deg); }
            100% { transform: translate(0, 0) rotate(360deg); }
        }

        /* MOTEUR DE RECHERCHE */
        .search-box { background: #008080; padding: 12px; margin: 10px auto 10px auto; max-width: 700px; border-radius: 20px; color: white; box-shadow: 0 4px 15px rgba(0,0,0,0.2); position: relative; z-index: 10; }
        .search-container { display: flex; flex-direction: column; gap: 8px; align-items: center; }
        .search-item { display: flex; flex-direction: column; align-items: center; width: 100%; }
        .search-item label { font-size: 0.75em; margin-bottom: 2px; font-weight: bold; color: #E0F2F1; }
        .search-item input { padding: 7px; border-radius: 12px; border: none; outline: none; text-align: center; color: #004D40; font-weight: bold; }
        .input-large { width: 90%; max-width: 500px; }
        .input-ville { width: 40%; max-width: 220px; }

        /* REGISTRE & CARTES */
        .registre-titre { color: #008080; margin: 10px 0 5px 0; font-size: 1.2em; }
        .mur-reel { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 15px; padding: 10px; max-width: 1200px; margin: 0 auto 50px auto; }
        
        .carte-message { 
            background: rgba(255, 255, 255, 0.95); border: 3px solid #008080; border-radius: 12px; padding: 12px; 
            box-shadow: 4px 4px 0px #008080; transition: 0.3s; color: #333; text-align: left; cursor: pointer; 
            font-size: 0.85em; height: 140px; overflow-y: auto; display: flex; flex-direction: column;
            overflow-wrap: break-word; word-break: break-word;
        }
        .carte-message:hover { transform: translateY(-5px); box-shadow: 8px 8px 0px #2E7D32; }

        /* ZOOM GÉANT */
        #fond-sombre { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.85); z-index: 2000; justify-content: center; align-items: center; }
        .message-geant { 
            background: #FFFFF0; width: 92%; max-width: 850px; max-height: 85vh; padding: 35px; border-radius: 30px; 
            border: 10px solid #008080; position: relative; text-align: center; overflow-y: auto;
            overflow-wrap: break-word; word-break: break-word;
        }
        .bouton-fermer { position: absolute; top: 10px; right: 15px; background: #FF1493; color: white; border: 4px solid white; border-radius: 50%; width: 40px; height: 40px; cursor: pointer; font-weight: bold; font-size: 20px; z-index: 10; }

        /* COPYRIGHT DISCRET */
        .copyright-wrapper { position: fixed; bottom: 5px; left: 50%; transform: translateX(-50%); background: rgba(255,255,255,0.6); padding: 3px 10px; border-radius: 15px; z-index: 1000; border: 1px solid rgba(0,128,128,0.3); font-size: 0.65em; opacity: 0.8; }

        /* ANIMAL ET BULLE */
        #animal-container { position: fixed; z-index: 900; white-space: nowrap; display: flex; align-items: center; cursor: pointer; pointer-events: auto; }
        #corps-animal { font-size: 35px; order: 1; transform: scaleX(-1); margin-right: -5px; }
        #bulle-texte { 
            order: 2; background: rgba(255, 255, 255, 0.9); border-radius: 12px; padding: 6px 12px; 
            font-style: italic; color: #2E7D32; font-weight: bold; border: 2px solid #2E7D32; 
            max-width: 180px; font-size: 0.8em; white-space: normal; overflow-wrap: break-word;
        }

        /* EFFET ÉTOILES AU CLIC */
        .magie { position: fixed; pointer-events: none; z-index: 1001; animation: eclatMagique 1.5s ease-out forwards; }
        @keyframes eclatMagique {
            0% { transform: translate(0,0) scale(1) rotate(0deg); opacity: 1; }
            100% { transform: translate(var(--mx), var(--my)) scale(0) rotate(360deg); opacity: 0; }
        }
        
        #chargement { font-weight: bold; color: #008080; margin: 10px; font-size: 1.1em; }
    </style>
</head>
